# Copy this file to .env.local and fill in real values.

# ADMIN_PASSWORD: Required. Protects the merchant dashboard (/admin) and every /api/admin/* route.
# Use a long random value. The dashboard is disabled until this is set.
ADMIN_PASSWORD=""

# SITE_URL: Your public address, e.g. https://www.example.com (no trailing slash).
# Used for canonical links, the sitemap, robots.txt and social previews. Read at runtime.
SITE_URL=""

# Razorpay API keys from https://dashboard.razorpay.com/app/keys
# These can also be saved from the merchant dashboard (stored in data/config.json).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: The secret you choose when adding the webhook in
# Razorpay Dashboard → Settings → Webhooks (URL: https://YOUR-DOMAIN/api/razorpay/webhook,
# event: order.paid). Lets the server create a customer's pass even if they close the tab.
RAZORPAY_WEBHOOK_SECRET=""

# MASTER_DRIVE_LINK: The Google Drive folder customers are sent to after paying.
# Keep it ONLY here or in /admin settings. Never commit it: the repository is public.
MASTER_DRIVE_LINK=""

# Support email shown to customers.
SUPPORT_EMAIL="helpeasemymart@gmail.com"

# ALLOW_SANDBOX_PAYMENTS: When Razorpay keys are NOT configured, checkout issues free
# simulated download passes. Allowed by default in development only.
# Set to "true" to allow it in production too (anyone could then download for free).
ALLOW_SANDBOX_PAYMENTS=""

# DATA_DIR: Where orders and settings are stored. Defaults to ./data. Must be persistent.
# DATA_DIR=""

# RAZORPAY_API_BASE: Test-only override used by the e2e suite's mock Razorpay. Leave unset.
